# ==============================================================================
# Frame AI PhotoBooth Backend Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000

# MongoDB Configuration
# For local MongoDB: mongodb://127.0.0.1:27017/aiphotobooth
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aiphotobooth?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/aiphotobooth

# ------------------------------------------------------------------------------
# DYNAMIC AI VIDEO PROVIDER CONFIGURATION
# Set your desired provider and model name here. No code changes needed!
# Supported Providers: mock | fal | replicate | runway | kling | luma
# ------------------------------------------------------------------------------
VIDEO_PROVIDER=mock

# Dynamic Model Name (Update as new AI models are released)
# Examples:
# For Fal.ai:
#   - fal-ai/kling-video/v1.5/pro/image-to-video
#   - fal-ai/kling-video/v1/standard/image-to-video
#   - fal-ai/luma-dream-machine/image-to-video
#   - fal-ai/minimax-video
#   - fal-ai/fast-svd
# For Replicate:
#   - kwaivgi/kling-v1.6-standard
#   - luma/ray
#   - minimax/video-01
#   - stability-ai/stable-video-diffusion
# For Runway:
#   - gen3a_turbo
# For Luma:
#   - ray-2
VIDEO_MODEL=fal-ai/kling-video/v1.5/pro/image-to-video

# ------------------------------------------------------------------------------
# Provider API Keys (Fill the one you are using)
# ------------------------------------------------------------------------------

# 1. Fal.ai (https://fal.ai)
FAL_KEY=

# 2. Replicate (https://replicate.com)
REPLICATE_API_TOKEN=

# 3. RunwayML (https://runwayml.com)
RUNWAY_API_SECRET=

# 4. Kling AI Direct (https://klingai.com)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# 5. Luma Dream Machine (https://lumalabs.ai)
LUMA_API_KEY=

# ------------------------------------------------------------------------------
# Generation Settings & Defaults
# ------------------------------------------------------------------------------
VIDEO_DURATION_SECONDS=5
VIDEO_ASPECT_RATIO=9:16
DEFAULT_MOTION_PROMPT=gentle warm smile, natural subtle head movement, glowing photorealistic lighting, cinematic portrait
STORAGE_TYPE=local
